# Gitforce — Environment Configuration
# Copy to .env and fill in values.

# --- App ---
GITFORCE_ENV=development
GITFORCE_DEBUG=true
GITFORCE_HOST=0.0.0.0
GITFORCE_PORT=8000

# --- Database ---
# PostgreSQL with pgvector
DATABASE_URL=postgresql+asyncpg://gitforce:gitforce@localhost:5432/gitforce

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- GitHub ---
# Preferred: GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=
# Fallback: PAT (avoid in production)
GITHUB_TOKEN=

# --- LLM ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Model routing defaults ---
MODEL_FAST=gpt-4o-mini
MODEL_CODING=gpt-4o
MODEL_REASONING=gpt-4o
MODEL_JUDGE=gpt-4o

# --- Retrieval ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Observability ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGSMITH_API_KEY=

# --- Execution / Sandbox ---
SANDBOX_NETWORK_RESTRICTED=true
SANDBOX_CPU_LIMIT=2.0
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_TIMEOUT_SECONDS=600

# --- Workflow ---
MAX_FIX_ITERATIONS=5
MAX_WORKFLOW_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=600
AGENT_MAX_ITERATIONS=20