# Gitforce — Environment Configuration
# Copy to .env and fill in values. All variables use the GITFORCE_ prefix
# (pydantic-settings env_prefix). Leaving optional values blank falls back
# to the defaults in gitforce/app/config/settings.py.

# --- App ---
GITFORCE_ENV=development
GITFORCE_DEBUG=true
GITFORCE_HOST=0.0.0.0
GITFORCE_PORT=8000

# --- Database ---
# PostgreSQL with pgvector. Run locally: docker compose up -d db
GITFORCE_DATABASE_URL=postgresql+asyncpg://gitforce:gitforce@localhost:5432/gitforce

# --- Redis ---
# Run locally: docker compose up -d redis
GITFORCE_REDIS_URL=redis://localhost:6379/0

# --- GitHub ---
# Preferred: GitHub App (github.com/settings/apps/new -> private key PEM + App ID;
# install on a repo -> Installation ID).
GITFORCE_GITHUB_APP_ID=
GITFORCE_GITHUB_APP_PRIVATE_KEY_PATH=
GITFORCE_GITHUB_APP_INSTALLATION_ID=
# Fallback: PAT (github.com/settings/tokens, scope: repo). Avoid in production.
GITFORCE_GITHUB_TOKEN=

# --- LLM ---
# openai | anthropic | google | groq | mock | local
GITFORCE_LLM_PROVIDER=openai
GITFORCE_OPENAI_API_KEY=
GITFORCE_ANTHROPIC_API_KEY=
GITFORCE_GOOGLE_API_KEY=
GITFORCE_GROQ_API_KEY=
GITFORCE_LOCAL_LLM_BASE_URL=
GITFORCE_LOCAL_LLM_API_KEY=

# --- Model routing defaults ---
GITFORCE_MODEL_FAST=gpt-4o-mini
GITFORCE_MODEL_CODING=gpt-4o
GITFORCE_MODEL_REASONING=gpt-4o
GITFORCE_MODEL_JUDGE=gpt-4o

# --- Retrieval ---
# hash | openai | local
GITFORCE_EMBEDDING_PROVIDER=hash
GITFORCE_EMBEDDING_MODEL=text-embedding-3-small
GITFORCE_EMBEDDING_DIMENSIONS=1536
GITFORCE_RAG_MAX_CHUNKS=2000
GITFORCE_RAG_TOP_K=8

# --- Observability (optional) ---
GITFORCE_OTEL_ENABLED=false
GITFORCE_OTEL_EXPORTER_OTLP_ENDPOINT=
GITFORCE_LANGSMITH_API_KEY=

# --- Execution / Sandbox ---
# docker | local
GITFORCE_SANDBOX_BACKEND=docker
GITFORCE_SANDBOX_NETWORK_RESTRICTED=true
GITFORCE_SANDBOX_CPU_LIMIT=2.0
GITFORCE_SANDBOX_MEMORY_LIMIT=2g
GITFORCE_SANDBOX_TIMEOUT_SECONDS=600
GITFORCE_SANDBOX_IMAGE=python:3.12-slim

# --- Workflow ---
GITFORCE_MAX_FIX_ITERATIONS=5
GITFORCE_MAX_WORKFLOW_ITERATIONS=10
GITFORCE_MAX_FEEDBACK_ITERATIONS=3
GITFORCE_AGENT_TIMEOUT_SECONDS=600
GITFORCE_AGENT_MAX_ITERATIONS=20
GITFORCE_AUTO_DISCOVER=true
GITFORCE_WORKSPACE_ROOT=workspaces

# --- Security / Rate limiting (Phase 12) ---
GITFORCE_RATE_LIMIT_ENABLED=true
GITFORCE_RATE_LIMIT_REQUESTS_PER_MINUTE=120
GITFORCE_RATE_LIMIT_BURST=200
GITFORCE_STRUCTURED_LOGGING=true
GITFORCE_ENABLE_SECRET_MANAGEMENT=true
